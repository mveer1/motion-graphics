{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "MotionStyleSystemRecord",
  "description": "Layer 5 of the component model: consistent rules for colour, typography, spacing, texture and motion. Tokens are implemented as CSS custom properties in the referenced stylesheet.",
  "type": "object",
  "required": [
    "id",
    "name",
    "status",
    "mode",
    "description",
    "location",
    "tokens",
    "motion",
    "fonts",
    "suitable_for",
    "tags"
  ],
  "additionalProperties": false,
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
    "name": { "type": "string" },
    "status": { "type": "string", "enum": ["proposed", "experimental", "approved", "deprecated", "blocked"] },
    "mode": { "type": "string", "enum": ["light", "dark", "mixed"] },
    "default": { "type": "boolean", "description": "True for the single workspace default style." },
    "description": { "type": "string" },
    "location": { "type": "string", "description": "Workspace-relative stylesheet (src/studio/styles/<id>.css)." },
    "tokens": {
      "type": "object",
      "required": ["colors", "typography"],
      "additionalProperties": false,
      "properties": {
        "colors": {
          "type": "object",
          "required": ["paper", "ink", "accent"],
          "additionalProperties": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" }
        },
        "typography": {
          "type": "object",
          "required": ["display", "text", "mono"],
          "additionalProperties": { "type": "string" }
        },
        "texture": { "type": "string" },
        "spacing": { "type": "string" }
      }
    },
    "motion": {
      "type": "object",
      "required": ["personality", "ease_in", "ease_out", "enter_duration_sec", "stagger_sec"],
      "additionalProperties": false,
      "properties": {
        "personality": { "type": "string" },
        "ease_in": { "type": "string" },
        "ease_out": { "type": "string" },
        "enter_duration_sec": { "type": "number", "exclusiveMinimum": 0 },
        "stagger_sec": { "type": "number", "minimum": 0 },
        "notes": { "type": "string" }
      }
    },
    "fonts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["family", "source", "license"],
        "additionalProperties": false,
        "properties": {
          "family": { "type": "string" },
          "source": { "type": "string", "enum": ["hyperframes-bundled", "system", "project-file"] },
          "license": { "type": "string" }
        }
      }
    },
    "contrast_checked": {
      "type": "array",
      "description": "Token pairs whose WCAG contrast ratio was computed, e.g. 'ink/paper 14.2:1'.",
      "items": { "type": "string" }
    },
    "suitable_for": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "avoid_for": { "type": "array", "items": { "type": "string" } },
    "validation": {
      "type": "object",
      "required": ["evidence", "last_verified"],
      "additionalProperties": false,
      "properties": {
        "evidence": { "type": "string" },
        "last_verified": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" }
      }
    },
    "related": { "type": "array", "items": { "type": "string", "pattern": "^[a-z0-9-]+$" } },
    "tags": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "metadata": { "type": "object" }
  }
}

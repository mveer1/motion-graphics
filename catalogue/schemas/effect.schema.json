{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "MotionVisualEffectRecord",
  "description": "Schema defining a visual effect capability in the Motion Graphics Capability Catalogue.",
  "type": "object",
  "required": [
    "id",
    "name",
    "category",
    "visual_intent",
    "status",
    "library_dependencies",
    "rendering_engine",
    "tags",
    "performance_characteristics",
    "recipes",
    "implementation_summary"
  ],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$",
      "description": "Unique kebab-case slug identifying the visual effect."
    },
    "name": {
      "type": "string",
      "description": "Human-readable display name of the effect."
    },
    "category": {
      "type": "string",
      "enum": [
        "transition",
        "data_flow",
        "chart_reveal",
        "particle_system",
        "spatial_transform",
        "lighting_atmosphere",
        "typography",
        "mask_reveal",
        "path_draw",
        "shape_morph",
        "depth_parallax",
        "texture_material",
        "rhythm_sync",
        "loop",
        "layout"
      ],
      "description": "Visual effect category."
    },
    "visual_intent": {
      "type": "string",
      "description": "The pedagogical purpose, mental model, or visual communication problem this effect solves."
    },
    "status": {
      "type": "string",
      "enum": [
        "proposed",
        "experimental",
        "approved",
        "deprecated",
        "blocked"
      ],
      "description": "Approval state governing production use."
    },
    "library_dependencies": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9-]+$"
      },
      "description": "List of library record IDs this effect requires."
    },
    "rendering_engine": {
      "type": "string",
      "enum": [
        "svg_dom",
        "canvas2d",
        "video_layer",
        "webgl",
        "css_dom"
      ],
      "description": "Underlying Chromium rendering subsystem used."
    },
    "tags": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string" },
      "description": "Searchable keywords and visual taxonomy tags."
    },
    "performance_characteristics": {
      "type": "object",
      "required": [
        "cpu_intensity",
        "gpu_intensity",
        "memory_profile"
      ],
      "additionalProperties": false,
      "properties": {
        "cpu_intensity": {
          "type": "string",
          "enum": ["low", "medium", "high"],
          "description": "CPU overhead during rendering."
        },
        "gpu_intensity": {
          "type": "string",
          "enum": ["low", "medium", "high"],
          "description": "GPU overhead during rendering."
        },
        "dom_node_count": {
          "type": "string",
          "description": "Estimated DOM node footprint (e.g. '<10 nodes', '2 containers')."
        },
        "memory_profile": {
          "type": "string",
          "description": "Estimated RAM/VRAM footprint."
        }
      }
    },
    "recipes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9-]+$"
      },
      "description": "List of recipe IDs that implement this effect."
    },
    "implementation_summary": {
      "type": "string",
      "description": "High-level summary of the implementation approach."
    },
    "primitives": {
      "type": "array",
      "items": { "type": "string", "pattern": "^[a-z0-9-]+$" },
      "description": "Primitive record IDs this effect animates."
    },
    "runtime_api": {
      "type": "string",
      "description": "Studio runtime call that implements the effect (src/studio/), if any."
    },
    "formats_supported": {
      "type": "array",
      "items": { "type": "string", "enum": ["landscape", "portrait", "square"] }
    },
    "examples": {
      "type": "array",
      "items": { "type": "string" }
    },
    "related": {
      "type": "array",
      "items": { "type": "string", "pattern": "^[a-z0-9-]+$" }
    },
    "validation": {
      "type": "object",
      "required": ["evidence", "last_verified"],
      "additionalProperties": false,
      "properties": {
        "evidence": { "type": "string" },
        "last_verified": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" }
      }
    },
    "metadata": {
      "type": "object",
      "properties": {
        "author": { "type": "string" },
        "created_at": { "type": "string" },
        "updated_at": { "type": "string" }
      }
    }
  }
}


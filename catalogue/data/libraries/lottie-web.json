{
  "id": "lottie-web",
  "name": "Lottie Web (Bodymovin Animation Player)",
  "version": "5.12.2",
  "category": "vector_graphics",
  "status": "experimental",
  "licensing": {
    "spdx_identifier": "MIT",
    "status": "verified",
    "commercial_use": true,
    "attribution_required": false,
    "notes": "MIT License verified (Airbnb / Hernan Torrisi)."
  },
  "documentation_urls": [
    "https://github.com/airbnb/lottie-web"
  ],
  "runtime_environment": {
    "type": "browser_script",
    "cdn_url": "https://cdnjs.cloudflare.com/ajax/libs/lottie-web/5.12.2/lottie.min.js",
    "npm_package": "lottie-web",
    "bundle_size_kb": 65.0
  },
  "rendering_constraints": {
    "max_memory_mb": 200,
    "target_fps": 30,
    "headless_chromium_compatible": true,
    "deterministic_mode_supported": true,
    "notes": "Use SVG renderer mode with autoplay: false. Timeline scrub driven deterministically via GSAP anim.goToAndStop(playhead.frame, true)."
  },
  "compatibility": {
    "apple_silicon_tested": true,
    "hyperframes_compatible": true,
    "low_memory_mode_compatible": true
  },
  "justification": "Experimental runtime for rendering declarative JSON vector animations generated via Text-to-Lottie or exported from After Effects. Validated in tests/prototypes/lottie/ rendering 120 frames in 10.7s at 1280x720 30fps with 0 dropped frames.",
  "effects_provided": [
    "lottie-vector-animation"
  ],
  "metadata": {
    "author": "Hernan Torrisi",
    "created_at": "2026-10-30",
    "updated_at": "2026-10-30",
    "tags": ["lottie", "vector", "json", "svg", "experimental"]
  }
}


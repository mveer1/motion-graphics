{
  "id": "timeline",
  "name": "Progressive milestone timeline",
  "purpose": "Sequential chronological timeline with advancing spine line, milestone nodes, date markers, and expanding callout cards.",
  "status": "experimental",
  "uses": {
    "primitives": [
      "scene-container",
      "styled-text",
      "svg-path"
    ],
    "effects": [
      "text-mask-rise",
      "hand-underline"
    ],
    "recipes": [
      "line-mask-rise",
      "underline-draw"
    ]
  },
  "formats_supported": [
    "landscape",
    "portrait",
    "square"
  ],
  "inputs": [
    {
      "name": "milestones",
      "type": "array",
      "description": "Array of { date, title, desc, tag } objects"
    },
    {
      "name": "orientation",
      "type": "string",
      "description": "horizontal or vertical progression"
    }
  ],
  "implementation": {
    "location": "src/studio/studio-compositions.js",
    "api": "Studio.comp.timeline(parent, { milestones, orientation })"
  },
  "layout_notes": "Automatically selects horizontal progression for landscape viewports and vertical progression for portrait/square viewports.",
  "styles_tested": [
    "editorial-light"
  ],
  "examples": [
    "tests/test-motion-primitives/index.html"
  ],
  "validation_steps": [
    "hyperframes check tests/test-motion-primitives",
    "hyperframes render tests/test-motion-primitives --low-memory-mode < /dev/null"
  ],
  "validation": {
    "evidence": "Tested and verified in tests/test-studio-primitives.",
    "last_verified": "2026-10-31"
  },
  "tags": [
    "composition",
    "timeline",
    "chronology",
    "milestones",
    "sequence"
  ],
  "metadata": {
    "author": "Antigravity",
    "created_at": "2026-10-31",
    "updated_at": "2026-10-31"
  }
}


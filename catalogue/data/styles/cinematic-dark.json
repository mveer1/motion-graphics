  "status": "experimental",
  "mode": "dark",
  "default": false,
  "description": "Near-black with warm highlights, condensed capitals and serif italics; slow pushes and long dissolves for title sequences when a dark direction is requested.",
  "location": "src/studio/styles/cinematic-dark.css",
  "tokens": {
    "colors": {
      "paper": "#0b0b0c",
      "paper-2": "#161616",

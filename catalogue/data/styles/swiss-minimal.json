{
  "id": "swiss-minimal",
  "name": "Swiss Minimal",
  "status": "experimental",
  "mode": "light",
  "default": false,
  "description": "High-contrast light grid, heavy grotesk, one signal red, snappy timing and hard cuts. For kinetic typography and announcements.",
  "location": "src/studio/styles/swiss-minimal.css",
  "tokens": {
    "colors": {
      "paper": "#f7f7f5",
      "paper-2": "#ececea",
      "ink": "#111111",
      "ink-2": "#4d4d4d",
      "rule": "#d6d6d3",
      "accent": "#d80f1a",
      "accent-2": "#111111",
      "accent-3": "#2a52be"
    },
    "typography": {
      "display": "'Inter', sans-serif",
      "text": "'Inter', sans-serif",
      "mono": "'IBM Plex Mono', monospace"
    },
    "texture": "Optional Studio.texture.grain overlay; blend from --grain-blend",
    "spacing": "--u = 1% of short side; --gap; safe-area insets per format"
  },
  "motion": {
    "personality": "Precise and energetic",
    "ease_in": "power3.in",
    "ease_out": "power4.out",
    "enter_duration_sec": 0.45,
    "stagger_sec": 0.035,
    "notes": "Cut on beats; big type; no decorative motion."
  },
  "fonts": [
    {
      "family": "Inter",
      "source": "hyperframes-bundled",
      "license": "OFL-1.1"
    },
    {
      "family": "IBM Plex Mono",
      "source": "hyperframes-bundled",
      "license": "OFL-1.1"
    }
  ],
  "contrast_checked": [
    "ink/paper 17.6:1",
    "ink-2/paper 7.9:1",
    "accent/paper 4.9:1"
  ],
  "suitable_for": [
    "kinetic typography",
    "announcements",
    "minimalist motion graphics",
    "rhythm-driven edits"
  ],
  "validation": {
    "evidence": "Contrast ratios computed from the stylesheet hex values (WCAG 2.x formula), 2026-10-30. Not yet used in a rendered project.",
    "last_verified": "2026-10-30"
  },
  "tags": [
    "light",
    "swiss",
    "minimal",
    "high-contrast"
  ],
  "metadata": {
    "author": "MotionLab",
    "created_at": "2026-10-30",
    "updated_at": "2026-10-30"
  }

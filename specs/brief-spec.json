{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "MotionLabCreativeBrief",
  "description": "Stage 0 creative brief: WHAT the piece must achieve and for whom, plus up to three distinct creative directions and the recorded choice. Instance file: projects/<slug>/brief.json. HOW to render lives in project.json (specs/video-spec.json).",
  "type": "object",
  "required": [
    "spec_version",
    "slug",
    "title",
    "objective",
    "audience",
    "platforms",
    "deliverables",
    "message",
    "tone",
    "audio",
    "research",
    "complexity",
    "creative_directions",
    "selected_direction"
  ],
  "additionalProperties": false,
  "properties": {
    "spec_version": { "const": 1 },
    "slug": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
    "title": { "type": "string", "minLength": 1 },
    "objective": { "type": "string", "minLength": 10, "description": "What the video must achieve, in one or two sentences." },
    "audience": { "type": "string", "minLength": 3 },
    "platforms": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "enum": ["youtube", "youtube-shorts", "instagram-reels", "instagram-feed", "tiktok", "linkedin", "website", "presentation", "broadcast", "other"]
      }
    },
    "deliverables": {
      "type": "object",
      "required": ["formats", "duration_sec"],
      "additionalProperties": false,
      "properties": {
        "formats": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "enum": ["landscape", "portrait", "square"] }
        },
        "duration_sec": {
          "type": "object",
          "required": ["target"],
          "additionalProperties": false,
          "properties": {
            "min": { "type": "number", "exclusiveMinimum": 0 },
            "target": { "type": "number", "exclusiveMinimum": 0 },
            "max": { "type": "number", "exclusiveMinimum": 0 }
          }
        },
        "other": { "type": "array", "items": { "type": "string" }, "description": "Stills, GIF, captions file, etc." }
      }
    },
    "message": {
      "type": "object",
      "required": ["core_message", "key_points"],
      "additionalProperties": false,
      "properties": {
        "core_message": { "type": "string", "minLength": 5 },
        "key_points": { "type": "array", "items": { "type": "string" } },
        "call_to_action": { "type": "string" }
      }
    },
    "tone": {
      "type": "object",
      "required": ["emotional_response", "keywords"],
      "additionalProperties": false,
      "properties": {
        "emotional_response": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "keywords": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "avoid": { "type": "array", "items": { "type": "string" } }
      }
    },
    "constraints": { "type": "array", "items": { "type": "string" } },
    "assets_provided": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "rights"],
        "additionalProperties": false,
        "properties": {
          "name": { "type": "string" },
          "path": { "type": "string" },
          "rights": { "type": "string", "description": "Who owns it and what use is allowed." }
        }
      }
    },
    "references": {
      "type": "array",
      "description": "Reference material the user supplied. 'inspected' is true only if it was actually viewed.",
      "items": {
        "type": "object",
        "required": ["description", "inspected"],
        "additionalProperties": false,
        "properties": {
          "description": { "type": "string" },
          "url": { "type": "string" },
          "inspected": { "type": "boolean" },
          "technique_ids": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "audio": {
      "type": "object",
      "required": ["narration", "music", "sfx", "captions"],
      "additionalProperties": false,
      "properties": {
        "narration": { "type": "string", "enum": ["required", "optional", "none"] },
        "music": { "type": "string", "enum": ["required", "optional", "none"] },
        "sfx": { "type": "string", "enum": ["required", "optional", "none"] },
        "captions": { "type": "boolean" },
        "notes": { "type": "string" }
      }
    },
    "research": {
      "type": "object",
      "required": ["required", "reason"],
      "additionalProperties": false,
      "properties": {
        "required": { "type": "boolean", "description": "True when the piece makes factual, technical or scientific claims that need a research dossier (Stage 0R)." },
        "reason": { "type": "string" }
      }
    },
    "complexity": {
      "type": "string",
      "enum": ["simple", "standard", "complex"],
      "description": "simple: skip directions and storyboard if the brief is fully specified. complex: storyboard required."
    },
    "creative_directions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "items": { "$ref": "#/definitions/direction" }
    },
    "selected_direction": {
      "type": ["string", "null"],
      "description": "ID of the chosen direction, or null while awaiting a decision."
    },
    "selection_rationale": { "type": "string" },
    "success_criteria": { "type": "array", "items": { "type": "string" } }
  },
  "definitions": {
    "direction": {
      "type": "object",
      "required": ["id", "name", "concept", "visual_identity", "motion_language", "composition", "pacing", "why_it_fits"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
        "name": { "type": "string" },
        "concept": { "type": "string", "minLength": 20 },
        "visual_identity": {
          "type": "object",
          "required": ["style_system", "palette", "typography", "texture"],
          "additionalProperties": false,
          "properties": {
            "style_system": { "type": "string", "pattern": "^[a-z0-9-]+$" },
            "palette": { "type": "string" },
            "typography": { "type": "string" },
            "texture": { "type": "string" },
            "imagery": { "type": "string" }
          }
        },
        "motion_language": {
          "type": "object",
          "required": ["personality", "signature_moves", "transitions"],
          "additionalProperties": false,
          "properties": {
            "personality": { "type": "string" },
            "signature_moves": { "type": "array", "minItems": 1, "items": { "type": "string" } },
            "transitions": { "type": "string" },
            "capabilities": { "type": "array", "items": { "type": "string" } }
          }
        },
        "composition": {
          "type": "object",
          "required": ["approach"],
          "additionalProperties": false,
          "properties": {
            "approach": { "type": "string" },
            "landscape": { "type": "string" },
            "portrait": { "type": "string" },
            "square": { "type": "string" }
          }
        },
        "pacing": { "type": "string" },
        "why_it_fits": { "type": "string" },
        "risks": { "type": "string" }
      }
    }
  }
}

{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "MotionGraphicsResearchSpec",
  "description": "Standardized schema for technical and scientific topic research dossiers in the motion graphics pipeline.",
  "type": "object",
  "required": [
    "metadata",
    "pedagogy",
    "ground_truth",
    "visual_metaphors",
    "acoustic_guidance",
    "scene_blueprint"
  ],
  "properties": {
    "metadata": {
      "type": "object",
      "required": ["topic_id", "title", "domain", "difficulty", "target_duration_sec", "canonical_sources"],
      "properties": {
        "topic_id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
          "description": "Kebab-case unique slug for the topic (e.g. 'neural-network-learning', 'raft-consensus')."
        },
        "title": {
          "type": "string",
          "description": "Human-readable canonical title for the video explainer."
        },
        "domain": {
          "type": "string",
          "enum": [
            "deep_learning",
            "machine_learning",
            "computer_systems",
            "distributed_systems",
            "database_internals",
            "networking",
            "cryptography",
            "algorithms_data_structures",
            "physics_mathematics",
            "software_engineering"
          ]
        },
        "difficulty": {
          "type": "string",
          "enum": ["introductory", "intermediate", "advanced"]
        },
        "target_duration_sec": {
          "type": "object",
          "required": ["min", "max", "target"],
          "properties": {
            "min": { "type": "number", "minimum": 10 },
            "max": { "type": "number", "maximum": 300 },
            "target": { "type": "number" }
          }
        },
        "canonical_sources": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["title", "source_type"],
            "properties": {
              "title": { "type": "string" },
              "authors": { "type": "string" },
              "year": { "type": "integer" },
              "source_type": {
                "type": "string",
                "enum": ["academic_paper", "rfc_spec", "official_doc", "textbook", "benchmark_report"]
              },
              "url": { "type": "string" }
            }
          }
        }
      }
    },
    "pedagogy": {
      "type": "object",
      "required": ["problem_statement", "core_thesis", "mental_model", "key_takeaway", "verified_claims"],
      "properties": {
        "problem_statement": {
          "type": "string",
          "description": "The fundamental tension, mystery, or computational bottleneck being resolved."
        },
        "core_thesis": {
          "type": "string",
          "description": "The central mechanical truth explained by the video in 1-2 sentences."
        },
        "mental_model": {
          "type": "string",
          "description": "The high-level intuitive metaphor connecting abstract mechanics to physical intuition."
        },
        "key_takeaway": {
          "type": "string",
          "description": "The single actionable conclusion the viewer should retain."
        },
        "verified_claims": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "string",
            "description": "Atomic factual assertions verified against ground truth literature."
          }
        },
        "anti_patterns": {
          "type": "array",
          "items": {
            "type": "string",
            "description": "Common misconceptions, inaccurate analogies, or technical pitfalls to strictly avoid."
          }
        }
      }
    },
    "ground_truth": {
      "type": "object",
      "required": ["entities", "equations", "algorithmic_steps"],
      "properties": {
        "entities": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["id", "symbol_latex", "name", "type_or_domain", "role"],
            "properties": {
              "id": { "type": "string" },
              "symbol_latex": { "type": "string" },
              "name": { "type": "string" },
              "type_or_domain": { "type": "string" },
              "role": { "type": "string" }
            }
          }
        },
        "equations": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "latex", "spoken_form", "context"],
            "properties": {
              "id": { "type": "string" },
              "latex": { "type": "string" },
              "spoken_form": { "type": "string" },
              "context": { "type": "string" }
            }
          }
        },
        "algorithmic_steps": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "object",
            "required": ["step_number", "phase_name", "mathematical_operation", "state_effect"],
            "properties": {
              "step_number": { "type": "integer" },
              "phase_name": { "type": "string" },
              "mathematical_operation": { "type": "string" },
              "state_effect": { "type": "string" }
            }
          }
        }
      }
    },
    "visual_metaphors": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "required": [
          "concept_id",
          "abstract_concept",
          "visual_archetype",
          "svg_primitives",
          "spatial_anchor",
          "motion_pattern",
          "color_token"
        ],
        "properties": {
          "concept_id": { "type": "string" },
          "abstract_concept": { "type": "string" },
          "visual_archetype": {
            "type": "string",
            "enum": [
              "node_network_graph",
              "vector_pulse_flow",
              "curved_landscape_descent",
              "b_tree_split_hierarchy",
              "state_machine_transition",
              "matrix_grid_transform",
              "ring_buffer_pipeline",
              "geometric_gauge_meter",
              "layer_stack_isometric",
              "scatter_cluster_distribution"
            ]
          },
          "svg_primitives": {
            "type": "array",
            "items": { "type": "string" },
            "description": "Recommended SVG elements (e.g. ['circle', 'line', 'path', 'filter'])."
          },
          "spatial_anchor": {
            "type": "string",
            "enum": [
              "canvas_center",
              "split_left_right",
              "three_column_layers",
              "top_header_bottom_stage",
              "radial_concentric",
              "bottom_dock_timeline"
            ]
          },
          "motion_pattern": {
            "type": "string",
            "description": "GSAP tween technique (e.g. 'drawSVG path illumination', 'staggered scale pulse', 'ease-in-out descent')."
          },
          "color_token": {
            "type": "string",
            "enum": [
              "accent_primary_blue",
              "accent_secondary_teal",
              "state_active_emerald",
              "gradient_error_coral",
              "warning_amber",
              "neutral_grid_charcoal"
            ]
          }
        }
      }
    },
    "acoustic_guidance": {
      "type": "object",
      "required": ["recommended_voice", "speech_rate", "inter_scene_pause_sec", "phonetic_lexicon"],
      "properties": {
        "recommended_voice": {
          "type": "string",
          "enum": ["am_adam", "af_bella", "am_michael", "af_sarah", "bm_george", "bf_emma"]
        },
        "speech_rate": {
          "type": "number",
          "minimum": 0.75,
          "maximum": 1.25,
          "default": 0.95
        },
        "inter_scene_pause_sec": {
          "type": "number",
          "default": 0.5
        },
        "phonetic_lexicon": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["term", "phonetic_respelling", "rationale"],
            "properties": {
              "term": { "type": "string" },
              "phonetic_respelling": { "type": "string" },
              "rationale": { "type": "string" }
            }
          }
        }
      }
    },
    "scene_blueprint": {
      "type": "array",
      "minItems": 3,
      "maxItems": 6,
      "items": {
        "type": "object",
        "required": [
          "scene_id",
          "title",
          "target_duration_sec",
          "pedagogical_objective",
          "visual_action",
          "active_entities"
        ],
        "properties": {
          "scene_id": {
            "type": "string",
            "pattern": "^s[1-9][0-9]*$"
          },
          "title": { "type": "string" },
          "target_duration_sec": { "type": "number" },
          "pedagogical_objective": { "type": "string" },
          "visual_action": { "type": "string" },
          "active_entities": {
            "type": "array",
            "items": { "type": "string" }
          }
        }
      }
    }
  }
}


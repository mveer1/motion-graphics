{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "MotionLabProductionSpec",
  "description": "Production (technical) specification: HOW a project is rendered. Instance file: projects/<slug>/project.json. The creative intent (WHAT and for whom) lives in brief.json (specs/brief-spec.json). Version 2 replaces the unused v1 draft (single resolution, dark theme defaults).",
  "type": "object",
  "required": ["spec_version", "slug", "title", "template", "style", "formats", "fps", "duration_sec", "timing", "audio"],
  "additionalProperties": false,
  "properties": {
    "spec_version": { "const": 2 },
    "slug": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
    "title": { "type": "string", "minLength": 1 },
    "template": { "type": "string", "pattern": "^[a-z0-9-]+$", "description": "Project template ID (catalogue/data/project-templates/)." },
    "style": { "type": "string", "pattern": "^[a-z0-9-]+$", "description": "Style system ID (catalogue/data/styles/)." },
    "formats": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "width", "height"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "enum": ["landscape", "portrait", "square"] },
          "width": { "type": "integer", "minimum": 16 },
          "height": { "type": "integer", "minimum": 16 },
          "primary": { "type": "boolean", "description": "The format written to src/index.html. Exactly one format is primary." },
          "platform": { "type": "string" },
          "safe_area": {
            "type": "object",
            "required": ["top", "right", "bottom", "left"],
            "additionalProperties": false,
            "properties": {
              "top": { "type": "number", "minimum": 0, "maximum": 0.45 },
              "right": { "type": "number", "minimum": 0, "maximum": 0.45 },
              "bottom": { "type": "number", "minimum": 0, "maximum": 0.45 },
              "left": { "type": "number", "minimum": 0, "maximum": 0.45 }
            }
          }
        }
      }
    },
    "fps": { "type": "integer", "enum": [24, 25, 30, 60] },
    "duration_sec": { "type": "number", "exclusiveMinimum": 0 },
    "quality": { "type": "string", "enum": ["draft", "looks", "delivery"], "default": "looks" },
    "timing": {
      "type": "object",
      "required": ["source"],
      "additionalProperties": false,
      "properties": {
        "source": { "type": "string", "enum": ["narration", "music", "fixed"] },
        "timeline_file": { "type": "string", "description": "audio/timeline.json when source is narration." },
        "beats_file": { "type": "string", "description": "Beat list (seconds) when source is music." }
      }
    },
    "audio": {
      "type": "object",
      "required": ["narration", "music", "sfx", "captions"],
      "additionalProperties": false,
      "properties": {
        "narration": { "type": "boolean" },
        "voice": { "type": "string" },
        "speed": { "type": "number", "minimum": 0.5, "maximum": 2.0 },
        "music": {
          "type": "object",
          "required": ["enabled"],
          "additionalProperties": false,
          "properties": {
            "enabled": { "type": "boolean" },
            "file": { "type": "string" },
            "license": { "type": "string", "description": "Licence and attribution text. Required when a music file is used." },
            "fade_out_sec": { "type": "number", "minimum": 0 }
          }
        },
        "sfx": { "type": "boolean" },
        "captions": { "type": "boolean" },
        "loudness_target_lufs": { "type": "number", "minimum": -30, "maximum": -9 },
        "loudness_tolerance_lu": { "type": "number", "minimum": 0.5, "maximum": 6 }
      }
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "version": { "type": "string" }
      }
    },
    "notes": { "type": "string" }
  }
}


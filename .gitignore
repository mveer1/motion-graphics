# ==============================================================================
# Motion Lab Pipeline - .gitignore
# This repository is the tool: runtime, scripts, specs, catalogue of reusable components,
# templates, skills and tests. Anything a user produces WITH it (their projects, series,
# renders, logs, asset library, progress notes) is personal and stays out of git.
# ==============================================================================

# --- Python Environment & Bytecode ---
.venv
.venv/
venv/
ENV/
env/
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
pip-wheel-metadata/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
.pytest_cache/
.mypy_cache/
.coverage
htmlcov/

# --- macOS / OS System Artifacts ---
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# --- Node / JavaScript Dependencies & Logs ---
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# --- HyperFrames Engine & Headless Browser Caches ---
.hyperframes/
**/.hyperframes/
.cache/
**/.cache/
snapshots/
**/snapshots/
.render.hf-transaction*
**/.render.hf-transaction*

# --- Render Outputs & Ephemeral Media (Domain 5 Placement Policy) ---
# Video and synthesized audio renders are ephemeral build outputs.
*.mp4
*.mov
*.webm
*.avi
*.mkv
projects/*/renders/
projects/**/renders/
projects/*/audio/*.wav
projects/**/audio/*.wav
projects/**/audio/history/
tests/_work/
tests/sfx_test/
tests/*.wav
archive/tests/

# Frame-review samples are regenerable (scripts/frame-review.py); keep only the report and the
# cross-format matrix that creative reviews cite as evidence.
projects/*/qa/frame-review/*
projects/**/qa/frame-review/*
!projects/*/qa/frame-review/report.json
!projects/**/qa/frame-review/report.json
!projects/*/qa/frame-review/contact-matrix.png
!projects/**/qa/frame-review/contact-matrix.png

# --- Reference corpus (scripts/reference-corpus.py) ---
# Analysis caches hold frames, contact sheets and audio panels extracted from third-party reference
# videos (rights unknown): never commit them. The reviewed records live in
# catalogue/data/reference-sources/ and the videos stay outside the repo.
reference/analysis/
# Reference-derived test compositions: keep report.json and contact sheets, not sampled frames.
tests/reference-derived/*/qa/*/

# --- Assets & Generated Artifacts ---
assets/generated/*
!assets/generated/.gitkeep

# --- Runtime Logs ---
logs/*
!logs/.gitkeep

# --- Security & Credentials (Zero Secrets Policy) ---
.env
.env.*
*.pem
*.key
*.token
id_rsa*
*.p12

# --- Concurrency & Locks ---
.locks/
.worktrees/

# --- IDEs & Editors ---
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.swp
*.swo
*~

# --- Creative intelligence layer ---
# Asset library: keep index.jsonl and job records (small, carry provenance); media and in-flight downloads are regenerable.
assets/library/files/
assets/library/incoming/
# Design DNA / knowledge-base caches (derived; contact sheets contain third-party frames).
reference/design-dna/
reference/design-kb/
# Bake-off candidates are regenerated by scripts/bakeoff.py; keep bakeoff.json, the beat, the sheet and the stills.
projects/**/bakeoff/*/_studio/
projects/**/bakeoff/*/index.html
projects/**/bakeoff/*/still/
projects/**/bakeoff/*/sample.mp4
projects/**/bakeoff/_control-reskin/
# Motion QA working frames (reports and contact sheets are kept).
projects/**/qa/motion/frames/

# ==============================================================================
# Personal content (produced with the tool, not part of it)
# ==============================================================================

# --- Your films: projects/<slug>/, series/<slug>/ and finished files in out/ ---
projects/*
!projects/.gitkeep
# Sample project that tests/test-studio.py uses as a fixture. Delete these four lines (and
# repoint CHAI in that test) if you would rather ship no sample at all.
!projects/masala-chai/
projects/masala-chai/*
!projects/masala-chai/v1-recipe/

series/*
!series/.gitkeep

out/*
!out/.gitkeep

# --- Your catalogue output, notes and working files ---
# catalogue/data/ and catalogue/schemas/ are the tool's component library and stay tracked.
catalogue/project-progress.md

# --- Your asset library and downloaded media (provenance, third-party licences) ---
assets/library/*
!assets/library/.gitkeep
assets/audio/

# --- Local agent / editor state ---
.claude/settings.local.json
CLAUDE.local.md
.ruff_cache/

# ==============================================================================
# Motion Lab Pipeline - .gitignore
# Strictly adheres to Component Placement Policy & ephemeral output hygiene
# ==============================================================================

# --- Python Environment & Bytecode ---
.venv/
venv/
ENV/
env/
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
pip-wheel-metadata/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
.pytest_cache/
.mypy_cache/
.coverage
htmlcov/

# --- macOS / OS System Artifacts ---
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# --- Node / JavaScript Dependencies & Logs ---
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# --- HyperFrames Engine & Headless Browser Caches ---
.hyperframes/
**/.hyperframes/
.cache/
**/.cache/

# --- Render Outputs & Ephemeral Media (Domain 5 Placement Policy) ---
# Video and synthesized audio renders are ephemeral build outputs.
projects/*/renders/
projects/*/audio/*.wav
out/*.mp4
out/*.mov
out/*.webm
out/*.avi
out/*.mkv
tests/_work/
tests/sfx_test/
tests/*.mp4
tests/*.wav

# Retain timeline synchronization metadata, HTML showcase & poster assets
!projects/*/audio/timeline.json
!out/index.html
!out/posters/
!out/posters/**

# --- Assets & Generated Artifacts ---
assets/generated/*
!assets/generated/.gitkeep

# --- Runtime Logs ---
logs/*
!logs/.gitkeep

# --- Security & Credentials (Zero Secrets Policy) ---
.env
.env.*
*.pem
*.key
*.token
id_rsa*
*.p12

# --- IDEs & Editors ---
.idea/
.vscode/
*.swp
*.swo
*~

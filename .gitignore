# ==============================================================================
# Motion Lab Pipeline - .gitignore
# Strictly adheres to Component Placement Policy & ephemeral output hygiene
# ==============================================================================

# --- Python Environment & Bytecode ---
.venv/
venv/
ENV/
env/
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
pip-wheel-metadata/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
.pytest_cache/
.mypy_cache/
.coverage
htmlcov/

# --- macOS / OS System Artifacts ---
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# --- Node / JavaScript Dependencies & Logs ---
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# --- HyperFrames Engine & Headless Browser Caches ---
.hyperframes/
**/.hyperframes/
.cache/
**/.cache/
snapshots/
**/snapshots/
.render.hf-transaction*
**/.render.hf-transaction*

# --- Render Outputs & Ephemeral Media (Domain 5 Placement Policy) ---
# Video and synthesized audio renders are ephemeral build outputs.
*.mp4
*.mov
*.webm
*.avi
*.mkv
projects/*/renders/
projects/*/audio/*.wav
tests/_work/
tests/sfx_test/
tests/*.wav

# Frame-review samples are regenerable (scripts/frame-review.py); keep only the report and the
# cross-format matrix that creative reviews cite as evidence.
projects/*/qa/frame-review/*
!projects/*/qa/frame-review/report.json
!projects/*/qa/frame-review/contact-matrix.png

# --- Reference corpus (scripts/reference-corpus.py) ---
# Analysis caches hold frames, contact sheets and audio panels extracted from third-party reference
# videos (rights unknown): never commit them. The reviewed records live in
# catalogue/data/reference-sources/ and the videos stay outside the repo.
out/reference-analysis/
# Reference-derived test compositions: keep report.json and contact sheets, not sampled frames.
tests/reference-derived/*/qa/*/

# Retain timeline synchronization metadata, HTML showcase & poster assets
!projects/*/audio/timeline.json
!out/index.html
!out/posters/
!out/posters/**

# --- Assets & Generated Artifacts ---
assets/generated/*
!assets/generated/.gitkeep

# --- Runtime Logs ---
logs/*
!logs/.gitkeep

# --- Security & Credentials (Zero Secrets Policy) ---
.env
.env.*
*.pem
*.key
*.token
id_rsa*
*.p12

# --- IDEs & Editors ---
.idea/
.vscode/
*.swp
*.swo
*~
